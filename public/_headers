# Vite bundles carry a content hash in the name: safe to cache forever.
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable

# Fixed-name files (photos, logos, font, icons): cache for a week, revalidate after.
/assets/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/*.ttf
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/assets/logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
