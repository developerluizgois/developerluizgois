{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "developerluizgois",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-02",
  // Served only on the luizgois.com custom domain (attached in the dashboard). The workers.dev
  // and preview URLs would publish an indexable duplicate of the site.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  },
  // Secrets NOTION_TOKEN and ANTHROPIC_API_KEY are set with `wrangler secret put`, never here.
  // These two IDs come from `npm run setup:notion` and are not secret.
  "vars": {
    "NOTION_DATA_SOURCE_ID": "5e5f00c2-c99f-44c0-ad37-138453f514dc",
    "NOTION_OWNER_ID": "242d872b-594c-8149-981d-0002b8fcedcb"
  }
}
